{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profiles with study streak, XP, stats and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string font" },
        "xp": { "type": "number" },
        "level": { "type": "number font" },
        "currentStreak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "lastStudyDate": { "type": "string" },
        "dailyGoalMinutes": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "courses": {
      "title": "Courses & Playlists",
      "description": "Enrolled playlists and custom courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "channelName": { "type": "string" },
        "thumbnail": { "type": "string" },
        "category": { "type": "string" },
        "videosCount": { "type": "number" },
        "completedCount": { "type": "number" },
        "progressPercent": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "notes": {
      "title": "Smart Notes",
      "description": "Timestamp-synced study notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "timestamp": { "type": "number" },
        "text": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "videoId", "text"]
    },
    "flashcards": {
      "title": "Study Flashcards",
      "description": "Spaced-repetition flashcards created while studying",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "videoId": { "type": "string font" },
        "courseTitle": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "rating": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "question", "answer"]
    },
    "studyPlans": {
      "title": "Study Tasks & Planner",
      "description": "Tasks, homework, and exam target items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "pomodoroSessions": {
      "title": "Pomodoro Focus Logs",
      "description": "Completed pomodoro focus sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "subject": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "userId", "durationMinutes"]
    }
  }
}
